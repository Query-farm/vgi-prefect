# name: test/sql/prefect.test
# description: Every prefect table and function against the recorded Prefect 3.9.3 replay (self-hosted mount, basic auth)
# group: [prefect]

require vgi

require-env PREFECT_WORKER

require-env PREFECT_MOCK

statement ok
ATTACH 'prefect' (TYPE vgi, LOCATION '{PREFECT_WORKER}');

statement ok
LOAD json;

# No secret yet: a clear error that names the secret type.
statement error
SELECT count(*) FROM prefect.main.flows;
----
<REGEX>:.*CREATE SECRET \(TYPE prefect.*

# A small page size so every scan below crosses several pages.
statement ok
CREATE SECRET pf (TYPE prefect, API_URL '{PREFECT_MOCK}/api', AUTH_STRING 'admin:prefect-fixture-pw', PAGE_SIZE 3);

# ---------------------------------------------------------------- flows / deployments

query TT
SELECT name, tags FROM prefect.main.flows ORDER BY name;
----
broken-import	[]
etl-orders	[etl]
flaky-report	[]

query T
SELECT name FROM prefect.main.flows WHERE list_contains(tags, 'etl');
----
etl-orders

query TTTTTTI
SELECT name, flow_name, work_pool_name, work_queue_name, status, parameters, schedule_count FROM prefect.main.deployments;
----
nightly	etl-orders	local-pool	default	NOT_READY	{"n": 3}	1

query TTTTT
SELECT deployment_name, cron, timezone, active, interval_seconds FROM prefect.main.deployment_schedules;
----
nightly	0 6 * * *	UTC	true	NULL

# ---------------------------------------------------------------- flow runs

query TTI
SELECT flow_name, state_type, count(*) FROM prefect.main.flow_runs GROUP BY ALL ORDER BY ALL;
----
broken-import	FAILED	1
etl-orders	CANCELLED	1
etl-orders	COMPLETED	3
etl-orders	SCHEDULED	3
flaky-report	COMPLETED	1

query TTT
SELECT name, flow_name, state_name FROM prefect.main.flow_runs WHERE state_type IN ('FAILED', 'CANCELLED') ORDER BY name;
----
primitive-rat	etl-orders	Cancelled
urban-hawk	broken-import	Failed

query I
SELECT count(*) FROM prefect.main.flow_runs WHERE list_contains(tags, 'etl') AND state_type = 'COMPLETED';
----
3

query TT
SELECT name, deployment_name FROM prefect.main.flow_runs WHERE deployment_name = 'nightly' AND NOT auto_scheduled ORDER BY name;
----
flawless-mustang	nightly
primitive-rat	nightly

query I
SELECT count(*) FROM prefect.main.flow_runs WHERE auto_scheduled AND created_by_type = 'SCHEDULE' AND start_time IS NULL;
----
3

query TT
SELECT name, parameters->>'$.n' FROM prefect.main.flow_runs WHERE flow_name = 'etl-orders' AND start_time >= TIMESTAMPTZ '2026-11-15 07:36:13+00' AND start_time < TIMESTAMPTZ '2026-11-15 07:36:30+00' ORDER BY name;
----
flawless-mustang	4
invisible-partridge	8

query T
SELECT name FROM prefect.main.flow_runs WHERE work_pool_name = 'local-pool' AND state_type = 'COMPLETED';
----
flawless-mustang

# ---------------------------------------------------------------- task runs

query TIIT
SELECT name, run_count, max_retries, state_name FROM prefect.main.task_runs WHERE run_count > 1;
----
render-132	2	2	Completed

query TI
SELECT state_type, count(*) FROM prefect.main.task_runs GROUP BY ALL ORDER BY ALL;
----
COMPLETED	10
FAILED	1

query T
SELECT t.name FROM prefect.main.task_runs t JOIN prefect.main.flow_runs r ON t.flow_run_id = r.id WHERE r.name = 'invisible-partridge' ORDER BY t.name;
----
extract-c88
load-21c
transform-3a3

query I
SELECT count(*) FROM prefect.main.task_runs WHERE list_contains(tags, 'io');
----
6

# ---------------------------------------------------------------- logs

query TIT
SELECT level_name, level, count(*) FROM prefect.main.flow_run_logs GROUP BY ALL ORDER BY level;
----
info	20	19
error	40	1

query TI
SELECT level_name, count(*) FROM prefect.main.task_run_logs GROUP BY ALL ORDER BY ALL;
----
error	4
info	17
warning	1

query T
SELECT l.message FROM prefect.main.task_run_logs l JOIN prefect.main.task_runs t ON l.task_run_id = t.id WHERE t.name = 'validate-723' AND l.level_name = 'error' AND l.logger = 'prefect.task_runs' AND l.message LIKE 'batch%';
----
batch b-42 failed validation

query I
SELECT count(*) FROM prefect.main.task_run_logs WHERE level >= 30 AND timestamp >= TIMESTAMPTZ '2026-11-15 07:36:17.7055+00';
----
4

# ---------------------------------------------------------------- infrastructure

query TTTT
SELECT name, type, status, is_paused FROM prefect.main.work_pools;
----
local-pool	process	NOT_READY	false

query TTI
SELECT work_pool_name, name, priority FROM prefect.main.work_queues ORDER BY priority, name;
----
local-pool	default	1
local-pool	high-priority	2

query TT
SELECT name, work_pool_name FROM prefect.main.work_queues WHERE work_pool_name = 'local-pool' AND name = 'high-priority';
----
high-priority	local-pool

query TTTI
SELECT work_pool_name, name, status, heartbeat_interval_seconds FROM prefect.main.workers;
----
local-pool	fixture-worker	OFFLINE	30

query I
SELECT count(*) FROM prefect.main.workers WHERE work_pool_name = 'no-such-pool';
----
0

query TTTI
SELECT name, kind, tag, "limit" FROM prefect.main.concurrency_limits ORDER BY name;
----
tag:io	tag	io	2
warehouse-connections	global	NULL	4

# ---------------------------------------------------------------- automations / events

query TTTT
SELECT name, enabled, trigger_type, trigger_definition->>'$.posture' FROM prefect.main.automations;
----
notify-on-failure	true	event	Reactive

query I
SELECT count(*) FROM prefect.main.events;
----
116

query TT
SELECT event, resource_name FROM prefect.main.events WHERE event = 'prefect.flow-run.Failed';
----
prefect.flow-run.Failed	urban-hawk

query TI
SELECT event, count(*) FROM prefect.main.events WHERE starts_with(event, 'prefect.flow-run.') AND event <> 'prefect.flow-run.heartbeat' GROUP BY ALL ORDER BY ALL;
----
prefect.flow-run.Cancelled	1
prefect.flow-run.Completed	4
prefect.flow-run.Failed	1
prefect.flow-run.Pending	5
prefect.flow-run.Running	5
prefect.flow-run.Scheduled	2
prefect.flow-run.Submitting	1
prefect.flow-run.pull-step.executed	1

query I
SELECT count(*) FROM prefect.main.events WHERE occurred >= TIMESTAMPTZ '2026-11-15 07:36:17+00' AND occurred < TIMESTAMPTZ '2026-11-15 07:36:18+00' AND event LIKE 'prefect.task-run.%';
----
9

# ---------------------------------------------------------------- artifacts / blocks / variables

query TTI
SELECT key, type, count(*) FROM prefect.main.artifacts GROUP BY ALL ORDER BY ALL;
----
orders-report	markdown	3
orders-summary	table	3
report-link	markdown	1
NULL	NULL	1

query I
SELECT sum((data->'$[1].orders')::INT) FROM prefect.main.artifacts WHERE key = 'orders-summary';
----
8

query TTT
SELECT name, block_type_slug, secret_fields FROM prefect.main.block_documents ORDER BY name;
----
alerts-slack	slack-webhook	[url]
warehouse-dsn	secret	[value]

query I
SELECT count(*) FROM prefect.main.block_types WHERE slug IN ('secret', 'slack-webhook');
----
2

query TTTT
SELECT name, value, is_masked, value_type FROM prefect.main.variables ORDER BY name;
----
orders_threshold	***	true	number
report_owner	***	true	string
slack_hook	***	true	string
warehouse_password	***	true	string

query T
SELECT name FROM prefect.main.variables WHERE list_contains(tags, 'etl');
----
orders_threshold

query TTT
SELECT name, value, is_masked FROM prefect.main.variable_values(reveal := true) ORDER BY name;
----
orders_threshold	100	false
report_owner	data-team	false
slack_hook	***	true
warehouse_password	***	true

query I
SELECT count(*) FROM prefect.main.variable_values() WHERE value <> '***';
----
0

# ---------------------------------------------------------------- unified

query TTI
SELECT pipeline, status, count(*) FROM prefect.unified.runs GROUP BY ALL ORDER BY ALL;
----
broken-import	failed	1
etl-orders	cancelled	1
etl-orders	queued	3
etl-orders	success	3
flaky-report	success	1

query TI
SELECT trigger, count(*) FROM prefect.unified.runs GROUP BY ALL ORDER BY ALL;
----
api	2
manual	4
schedule	3

query TTT
SELECT orchestrator, pipeline, raw_status FROM prefect.unified.runs WHERE status = 'failed';
----
prefect	broken-import	Failed

query TII
SELECT task_name, attempt, count(*) FROM prefect.unified.task_runs GROUP BY ALL ORDER BY ALL;
----
extract	1	3
load	1	3
render	2	1
transform	1	3
validate	1	1

query TT
SELECT r.pipeline, t.status FROM prefect.unified.task_runs t JOIN prefect.unified.runs r USING (run_id) WHERE t.status <> 'success';
----
broken-import	failed

query I
SELECT count(*) FROM prefect.unified.runs WHERE status = 'skipped';
----
0

query T
SELECT bool_and(duration_seconds >= 0 AND url LIKE '{PREFECT_MOCK}/runs/flow-run/%') FROM prefect.unified.runs WHERE ended_at IS NOT NULL;
----
true

query TT
SELECT prefect.unified.unified_status('CRASHED'), prefect.unified.unified_status(NULL::VARCHAR);
----
failed	queued

# The same shape as every other orchestrator worker: UNION ALL just works.
query I
SELECT count(*) FROM (SELECT * FROM prefect.unified.runs UNION ALL SELECT 'other', 'r1', 'p', 'success', NULL, NULL, NULL, NULL, NULL, NULL, NULL);
----
10
